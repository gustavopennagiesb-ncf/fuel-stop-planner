# Copy to .env (never commit .env). PROVIDER: fixture | google | fallback
PROVIDER=fixture
EIA_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MAPS_JS_KEY=
# LLM: set either key; Groq is preferred (free tier at console.groq.com, no credit card needed).
# Anthropic works as a fallback. Without either key the app uses the deterministic template.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_MODEL=claude-haiku-5-5
